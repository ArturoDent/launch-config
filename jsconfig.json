{
  "compilerOptions": {
    "strict": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ESNext",
    "checkJs": true, /* Typecheck .js files. */
    "lib": [
      "ESNext",
      "DOM"
    ],
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0,
    "types": [
      "node",
      "mocha",
      "vscode"
    ]
  },
  "exclude": [
    "node_modules"
  ]
}
